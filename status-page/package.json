{
  "name": "bivouac-status-page",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "layers": "rm -rf .layers && mkdir .layers && cp -R ../app-layers/oidc .layers/oidc",
    "dev": "npm run layers && nuxt dev",
    "build": "npm run layers && nuxt build",
    "start": "node .output/server/index.mjs",
    "test": "vitest run",
    "dev:local": "sh scripts/dev.sh"
  },
  "dependencies": {
    "@nuxt/ui": "^4.12.0",
    "h3": "^1.15.11",
    "jose": "^6.1.3",
    "nuxt": "^4.6.4",
    "openid-client": "^6.8.9",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "typescript": "^6.0.0",
    "vitest": "^5.1.0"
  }
}

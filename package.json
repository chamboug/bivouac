{
  "name": "bivouac",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/manifest",
    "packages/bivy",
    "packages/reconciler"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "platform:up": "node packages/reconciler/e2e/cli.ts up",
    "platform:down": "node packages/reconciler/e2e/cli.ts down"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}

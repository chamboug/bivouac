# Butane base for the server, compiled to Ignition by `bivy ignition`.
# Ignition only runs on first boot: anything that must change later belongs
# to the reconciler, not here. This file holds no secrets (it ends up in the
# server's user-data, readable from the server).
# SSH keys are not written here: they are added from ssh-keys.yml.
# `bivy ignition` fills the placeholders (between double @) with the repository and
# the reconciler image of platform.yml, so they are written in one place.
variant: flatcar
version: 1.1.0
storage:
  files:
    - path: /etc/ssh/sshd_config.d/10-bivouac.conf
      mode: 0600
      overwrite: true
      contents:
        inline: |
          PermitRootLogin no
          PasswordAuthentication no
          KbdInteractiveAuthentication no
          AllowUsers core
    # Reboot after an OS update only between 04:00 and 05:00 (server time, UTC).
    - path: /etc/flatcar/update.conf
      mode: 0420
      overwrite: true
      contents:
        inline: |
          REBOOT_STRATEGY=reboot
          LOCKSMITHD_REBOOT_WINDOW_START=04:00
          LOCKSMITHD_REBOOT_WINDOW_LENGTH=1h
    # Containers must not read the metadata service: it serves this
    # file's compiled form (user-data) and other details of the server
    # (D7). A table of our own, which Docker never touches, so the rule
    # holds whatever Docker does to its own rules when it restarts. It
    # only sees forwarded traffic: the host itself still reads its
    # metadata at boot. Loading it twice gives the same result.
    - path: /etc/bivouac-metadata-block.nft
      mode: 0644
      overwrite: true
      contents:
        inline: |
          table inet bivouac_metadata
          flush table inet bivouac_metadata
          table inet bivouac_metadata {
            chain forward {
              type filter hook forward priority filter - 10; policy accept;
              ip daddr 169.254.169.254 counter reject
            }
          }
    # Applies the SSH keys the reconciler writes from ssh-keys.yml (D12).
    - path: /opt/bivouac/sync-ssh-keys
      mode: 0700
      overwrite: true
      contents:
        inline: |
          #!/bin/sh
          # Applies the SSH keys of the instance repo's ssh-keys.yml, written by
          # the reconciler, to the `core` user (D12). Run by bivouac-ssh-keys.path
          # when the list changes, by its timer as a backstop, and at every boot.
          # Writes the outcome to ssh-status/applied, which the reconciler reads:
          # a list that cannot be applied is reported, never silently ignored.
          set -eu
          # Byte-wise matching, the same on every system.
          export LC_ALL=C
          list=/var/lib/bivouac/ssh/authorized_keys
          status=/var/lib/bivouac/ssh-status/applied
          fragments=/home/core/.ssh/authorized_keys.d
          copy=/run/bivouac-ssh-keys.list
          report() {
            mkdir -p "${status%/*}"
            printf '%s\n' "$1" > "$status.tmp"
            mv "$status.tmp" "$status"
            echo "$1"
          }
          if [ ! -f "$list" ]; then
            echo "no key list from the reconciler yet: nothing to do"
            exit 0
          fi
          # Every line must be one public key, and there must be at least one:
          # anything else would lock everyone out, or let something odd in. The
          # same pattern as the reconciler's schema.
          key='^(ssh-ed25519|sk-ssh-ed25519@openssh\.com|ecdsa-sha2-nistp(256|384|521)|sk-ecdsa-sha2-nistp256@openssh\.com|ssh-rsa) [A-Za-z0-9+/]+={0,3}( [ -~]*)?$'
          # The list may change while it is applied: work on a copy, and start
          # again if the list moved meanwhile.
          for attempt in 1 2 3; do
            cp "$list" "$copy"
            hash=$(sha256sum "$copy" | cut -d ' ' -f 1)
            if grep -Evq "$key" "$copy"; then
              report "refused $hash: a line is not a public key"
              exit 1
            fi
            if ! grep -Eq "$key" "$copy"; then
              report "refused $hash: the list is empty, it would lock everyone out"
              exit 1
            fi
            if ! update-ssh-keys -u core -a bivouac "$copy"; then
              report "refused $hash: update-ssh-keys did not accept the list"
              exit 1
            fi
            # Only once the list is in place: remove every other set of keys
            # (Ignition's, the provider's metadata…), so ssh-keys.yml is the only
            # list and removing a key there really removes it.
            for path in "$fragments"/*; do
              name=${path##*/}
              if [ -f "$path" ] && [ "$name" != bivouac ]; then
                if ! update-ssh-keys -u core -d "$name"; then
                  report "refused $hash: could not remove the keys of '$name'"
                  exit 1
                fi
              fi
            done
            report "applied $hash"
            if [ "$(sha256sum "$list" | cut -d ' ' -f 1)" = "$hash" ]; then
              exit 0
            fi
          done
          echo "the list kept changing while it was applied: the next run will catch up"
          exit 1
    # Rolls the reconciler back when a new version keeps failing (D61).
    - path: /opt/bivouac/reconciler-trial
      mode: 0700
      overwrite: true
      contents:
        inline: |
          #!/bin/sh
          # Run by systemd before each start of bivouac-reconciler (D61). Before
          # moving to a new version, the reconciler writes trial.env (the new
          # version and the last one that proved itself); it removes it after
          # its first pass that does not crash. At the fourth start of a version still on
          # trial, this writes the previous version back to image.env and the
          # failed one to refused.env, which the previous version reads: it does
          # not move again until platform.yml names another version. It never
          # fails the start, never sources a file (values are matched first),
          # and removes a leftover *.new before writing (a symlink there is
          # not followed).
          set -u
          LC_ALL=C
          export LC_ALL
          dir=/var/lib/bivouac/reconciler
          trial=$dir/trial.env
          starts=$dir/trial.starts
          image_env=$dir/image.env
          pattern='^ghcr\.io/[a-z0-9][a-z0-9-]*/bivouac-reconciler(:sha-[0-9a-f]{7,40}(@sha256:[0-9a-f]{64})?|@sha256:[0-9a-f]{64})$'
          value() { sed -n "s/^$1=//p" "$2" 2>/dev/null | head -n 1; }
          valid() { printf '%s\n' "$1" | grep -Eqx "$pattern"; }
          [ -f "$trial" ] || exit 0
          candidate=$(value BIVOUAC_TRIAL_IMAGE "$trial")
          previous=$(value BIVOUAC_PREVIOUS_IMAGE "$trial")
          running=$(value BIVOUAC_RECONCILER_IMAGE "$image_env")
          if [ -z "$candidate" ] || [ "$candidate" != "$running" ]; then
            echo "the trial does not name the version being started: forgotten"
            rm -f "$trial" "$starts"
            exit 0
          fi
          count=$(cat "$starts" 2>/dev/null || true)
          case $count in '' | *[!0-9]*) count=0 ;; esac
          count=$((count + 1))
          umask 077
          if [ "$count" -le 3 ]; then
            echo "$candidate is on trial: start $count of 3"
            rm -f "$starts.new"
            printf '%s\n' "$count" > "$starts.new" && mv "$starts.new" "$starts"
            exit 0
          fi
          if ! valid "$candidate" || ! valid "$previous"; then
            echo "$candidate failed 3 starts, but the trial file is not as expected: left as is"
            exit 0
          fi
          rm -f "$dir/refused.env.new" "$image_env.new"
          printf 'BIVOUAC_REFUSED_IMAGE=%s\n' "$candidate" > "$dir/refused.env.new" && mv "$dir/refused.env.new" "$dir/refused.env"
          printf 'BIVOUAC_RECONCILER_IMAGE=%s\n' "$previous" > "$image_env.new" && mv "$image_env.new" "$image_env"
          rm -f "$trial" "$starts"
          echo "$candidate failed 3 starts: back to $previous"
  directories:
    # Age key and deploy key, placed over SSH (D7, D30).
    - path: /etc/bivouac
      mode: 0700
    # Files the reconciler generates (Caddyfile, secret files for the
    # containers): mounted at the same path in the reconciler (D55, D57).
    - path: /var/lib/bivouac
      mode: 0700
    # The key list written by the reconciler, watched by
    # bivouac-ssh-keys.path.
    - path: /var/lib/bivouac/ssh
      mode: 0700
    # Where sync-ssh-keys reports what it applied. Its presence tells the
    # reconciler that a host script is expected to answer.
    - path: /var/lib/bivouac/ssh-status
      mode: 0700
systemd:
  units:
    # Loads the metadata block. Docker requires it (drop-in below): no
    # container ever runs without the block, and if it cannot be loaded
    # Docker does not start at all.
    - name: bivouac-metadata-block.service
      contents: |
        [Unit]
        Description=Keep containers away from the metadata service

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/bin/nft -f /etc/bivouac-metadata-block.nft
    - name: docker.service
      dropins:
        - name: 10-bivouac-metadata-block.conf
          contents: |
            [Unit]
            Requires=bivouac-metadata-block.service
            After=bivouac-metadata-block.service
    # SSH keys (D12): the reconciler, which has no access to core's home,
    # writes ssh-keys.yml to /var/lib/bivouac/ssh/authorized_keys; this
    # path unit notices the change and the script applies it with
    # update-ssh-keys. The service also runs at every boot and every 15
    # minutes, in case a change was missed; it is harmless to run again.
    - name: bivouac-ssh-keys.path
      enabled: true
      contents: |
        [Unit]
        Description=Watch the SSH keys listed in the instance repo

        [Path]
        PathChanged=/var/lib/bivouac/ssh/authorized_keys

        [Install]
        WantedBy=multi-user.target
    - name: bivouac-ssh-keys.service
      enabled: true
      contents: |
        [Unit]
        Description=Apply the SSH keys listed in the instance repo
        After=coreos-metadata-sshkeys@core.service

        [Service]
        Type=oneshot
        ExecStart=/opt/bivouac/sync-ssh-keys

        [Install]
        WantedBy=multi-user.target
    - name: bivouac-ssh-keys.timer
      enabled: true
      contents: |
        [Unit]
        Description=Apply the SSH keys listed in the instance repo, as a backstop

        [Timer]
        OnBootSec=15min
        OnUnitActiveSec=15min

        [Install]
        WantedBy=timers.target
    # Starts the reconciler, which then manages everything else from Git.
    # The age key and deploy key are placed in /etc/bivouac over SSH by
    # `bivy init` / `bivy rebuild`, never through user-data.
    - name: bivouac-reconciler.service
      enabled: true
      contents: |
        [Unit]
        Description=Bivouac reconciler
        Requires=docker.service
        After=docker.service network-online.target
        Wants=network-online.target

        [Service]
        # The version installed with the server. Once platform.yml names
        # another one, the reconciler writes it to image.env and exits;
        # systemd restarts it on that version (EnvironmentFile= overrides
        # Environment=, D50). A new version that fails 3 starts is rolled
        # back by the drop-in below (D61). By hand: write the version wanted
        # to image.env.
        Environment=BIVOUAC_RECONCILER_IMAGE=@@RECONCILER_IMAGE@@
        EnvironmentFile=-/var/lib/bivouac/reconciler/image.env
        Restart=always
        RestartSec=10
        ExecStartPre=-/usr/bin/docker rm --force bivouac-reconciler
        # Only the reconciler gets the Docker socket (D8). It drops NET_RAW
        # and cannot gain privileges, like every container (D56).
        ExecStart=/usr/bin/docker run --rm --name bivouac-reconciler \
          --volume /var/run/docker.sock:/var/run/docker.sock \
          --volume /etc/bivouac:/etc/bivouac:ro \
          --volume /var/lib/bivouac:/var/lib/bivouac \
          --env BIVOUAC_REPOSITORY=@@REPOSITORY@@ \
          --env BIVOUAC_RECONCILER_IMAGE=${BIVOUAC_RECONCILER_IMAGE} \
          --cap-drop NET_RAW \
          --security-opt no-new-privileges \
          --log-opt max-size=10m --log-opt max-file=3 \
          ${BIVOUAC_RECONCILER_IMAGE}
        # "-": the container is started with --rm, so after a self-update (an
        # exit) it is already gone, and a failing stop must not mark the unit
        # failed.
        ExecStop=-/usr/bin/docker stop bivouac-reconciler

        [Install]
        WantedBy=multi-user.target
      # Counts the starts of a version on trial, and goes back to the
      # previous one after three (D61). A drop-in, so a server installed
      # before it gets the very same file. EnvironmentFile= is read again
      # for ExecStart=, after this has run (systemd.exec man page).
      dropins:
        - name: 20-bivouac-trial.conf
          contents: |
            [Service]
            ExecStartPre=-/opt/bivouac/reconciler-trial
